<template>
  <div style="flex-direction:column;width:336px;height:100%;background-color:#000000;" @swipe="onSwipe">
<!-- if true: process.env.SHAPE === "CIRCLE" -->


    <!-- ═══ 圆屏：优先级背景图 + 开关切图（64-71），同模式选择拼装方式 ═══ -->
    <div if="{{isCircle}}" style="position:absolute;left:0;top:0;width:336px;height:336px;">
      <scroll scroll-y="true" bounces="false" style="width:336px;height:336px;flex-direction:column;">
        <div static style="width:336px;height:548px;min-height:548px;flex-shrink:0;">
          <image src="../../common/circle-priority.png" style="position:absolute;left:0;top:0;width:336px;height:548px;"></image>
          <!-- 开关切图：高=71ON/67OFF 中=70ON/66OFF 低=69ON/65OFF 置顶=68ON/64OFF -->
          <image if="{{priority===3}}" src="../../common/circle-ctr-71.png" style="position:absolute;left:22px;top:111px;width:291px;height:77px;" onclick="sel(3)"></image>
          <image else src="../../common/circle-ctr-67.png" style="position:absolute;left:22px;top:111px;width:291px;height:77px;" onclick="sel(3)"></image>
          <image if="{{priority===2}}" src="../../common/circle-ctr-70.png" style="position:absolute;left:22px;top:197px;width:291px;height:77px;" onclick="sel(2)"></image>
          <image else src="../../common/circle-ctr-66.png" style="position:absolute;left:22px;top:197px;width:291px;height:77px;" onclick="sel(2)"></image>
          <image if="{{priority===1}}" src="../../common/circle-ctr-69.png" style="position:absolute;left:22px;top:283px;width:291px;height:77px;" onclick="sel(1)"></image>
          <image else src="../../common/circle-ctr-65.png" style="position:absolute;left:22px;top:283px;width:291px;height:77px;" onclick="sel(1)"></image>
          <image if="{{pinned}}" src="../../common/circle-ctr-68.png" style="position:absolute;left:22px;top:369px;width:291px;height:77px;" onclick="togglePin"></image>
          <image else src="../../common/circle-ctr-64.png" style="position:absolute;left:22px;top:369px;width:291px;height:77px;" onclick="togglePin"></image>
        </div>
      </scroll>
    </div>

    <!-- 矩形屏：简单列表（新页面，矩形也用但走简洁样式） -->
    <div if="{{isCircle === false}}" style="flex-direction:column;width:336px;height:100%;">
      <div static style="position:absolute;left:6px;top:6px;width:72px;height:72px;border-radius:36px;background-color:#262626;border-width:3px;border-color:rgba(255,255,255,0.06);justify-content:center;align-items:center;" onclick="goBack">
        <image src="../../common/icon-back.png" style="width:16px;height:27px;"></image>
      </div>
      <text  style="position:absolute;left:105px;top:10px;width:126px;text-align:center;font-size:26px;color:#999999;">{{timeStr}}</text>
      <text static style="position:absolute;left:100px;top:40px;width:136px;text-align:center;font-size:32px;font-weight:700;color:#FFFFFF;">优先级</text>

      <div static style="position:absolute;left:6px;top:90px;width:324px;height:112px;border-radius:24px;background-color:#262626;flex-direction:row;align-items:center;padding-left:28px;padding-right:28px;" onclick="sel(3)">
        <text static style="flex:1;font-size:32px;font-weight:700;color:#FFFFFF;">高优先级</text>
        <text  style="font-size:28px;color:{{priority===3 ? '#FF6B6B' : '#666666'}};">●</text>
      </div>
      <div static style="position:absolute;left:6px;top:210px;width:324px;height:112px;border-radius:24px;background-color:#262626;flex-direction:row;align-items:center;padding-left:28px;padding-right:28px;" onclick="sel(2)">
        <text static style="flex:1;font-size:32px;font-weight:700;color:#FFFFFF;">中优先级</text>
        <text  style="font-size:28px;color:{{priority===2 ? '#4A90D9' : '#666666'}};">●</text>
      </div>
      <div static style="position:absolute;left:6px;top:330px;width:324px;height:112px;border-radius:24px;background-color:#262626;flex-direction:row;align-items:center;padding-left:28px;padding-right:28px;" onclick="sel(1)">
        <text static style="flex:1;font-size:32px;font-weight:700;color:#FFFFFF;">低优先级</text>
        <text  style="font-size:28px;color:{{priority===1 ? '#9B59B6' : '#666666'}};">●</text>
      </div>
      <div static style="position:absolute;left:6px;top:450px;width:324px;height:112px;border-radius:24px;background-color:#262626;flex-direction:row;align-items:center;padding-left:28px;padding-right:28px;" onclick="togglePin">
        <text static style="flex:1;font-size:32px;font-weight:700;color:#FFFFFF;">置顶</text>
        <text  style="font-size:28px;color:{{pinned ? '#FF9800' : '#666666'}};">●</text>
      </div>
    </div>


  </div>
<!-- endif -->
<!-- endif -->
</template>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import prompt from '@system.prompt'
    import adapt from '../../common/adapt'

  const utils = global.utils || {}

  export default {
    private: {
      timeStr: '',
      priority: 2,
      pinned: false,
      isCircle: null
    },

    onInit () {
      this.isCircle = adapt.isCircleSync()
      utils.init(storage, prompt)
    },

    onShow () {
      var that = this
      that.updateTime()
      adapt.probe().then(function (info) {
        if (that.isCircle !== info.isCircle) { that.isCircle = info.isCircle }
      })
      // 读取当前选择
      utils.storageGet('todo_priority_sel').then(function (s) {
        if (s) {
          try {
            var o = JSON.parse(s)
            that.priority = o.priority
            that.pinned = !!o.pinned
          } catch (e) {}
        }
      })
    },

    onDestroy () {
      if (typeof global.runGC === "function") {
        global.runGC()
      }
    },

    updateTime () {
      var now = new Date()
      var h = now.getHours().toString(); if (h.length < 2) h = '0' + h
      var m = now.getMinutes().toString(); if (m.length < 2) m = '0' + m
      this.timeStr = h + ':' + m
    },

    sel (p) {
      this.priority = p
      this.save()
    },

    togglePin () {
      this.pinned = !this.pinned
      this.save()
    },

    save () {
      var that = this
      // 只保存不退出页面（同模式选择：点完留在本页继续切换）
      utils.storageSet('todo_priority_sel', JSON.stringify({ priority: that.priority, pinned: that.pinned }))
    },

    goBack () { router.back() },

    onSwipe (e) {
      if (e && e.direction === 'right') {
        router.back()
      }
    }
  }
</script>
